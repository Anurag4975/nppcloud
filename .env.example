# Canonical site origin — used by the CSRF guard to reject cross-origin
# mutating requests (cookie-based auth). Set to your production domain.
NEXT_PUBLIC_SITE_URL=https://mycloud.example.com

# ─── Supabase ───────────────────────────────────────────────
# From your NEW Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only, never exposed to the browser. Bypasses RLS — used only in API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Backblaze B2 (S3-compatible) ──────────────────────────
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_REGION=us-west-002
B2_BUCKET=mycloud-prod
B2_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key

# ─── Payment gateways (fill in when you reach Phase 5) ─────
ESEWA_MERCHANT_ID=
ESEWA_SECRET=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET=
